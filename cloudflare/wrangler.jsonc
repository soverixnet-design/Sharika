{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharika-api-staging",
  "main": "src/voice-worker.mjs",
  "compatibility_date": "2026-10-29",
  "previews": {},
  "account_id": "d81cf7c48fb9b36d468cb0a08720cd74",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sharika-staging",
      "database_id": "b2c62252-12a5-4740-90c7-01a536d9a39a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sharika-staging-media"
    }
  ],
  "vars": {
    "SHARIKA_ENV": "staging",
    "FIREBASE_PROJECT_ID": "sharika-voice-chat-app",
    "ALLOWED_ORIGINS": "",
    "SHARIKA_LUCKY_GIFTS_ENABLED": "false",
    "SHARIKA_COINS_CASH_REDEEMABLE": "false",
    "SHARIKA_FAMILY_SHEET_ID": "1u-6FRnn3noeK2-fQRT_FK_arengxQycZKXnJqjDEaxg",
    "SHARIKA_FAMILY_APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbzGb4_6f0poV_FsBuhHKR-huLT4H2-4cwYCKZ3qXtJKUTX8bISfdGRlX759EG3m351zUg/exec"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_ROOMS",
        "class_name": "SharikaVoiceRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_sharika_sfu_voice_rooms",
      "new_sqlite_classes": [
        "SharikaVoiceRoom"
      ]
    }
  ],
  "keep_vars": true,
  "secrets": {
    "required": [
      "REALTIME_SFU_APP_ID",
      "REALTIME_SFU_APP_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "SHARIKA_ACTION_RATE_LIMIT",
      "namespace_id": "410201",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SHARIKA_FINANCE_RATE_LIMIT",
      "namespace_id": "410202",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
