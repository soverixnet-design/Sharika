{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharika-api-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-29",
  "account_id": "d81cf7c48fb9b36d468cb0a08720cd74",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sharika-staging",
      "database_id": "b2c62252-12a5-4740-90c7-01a536d9a39a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SHARIKA_ENV": "staging",
    "FIREBASE_PROJECT_ID": "",
    "ALLOWED_ORIGINS": ""
  }
}
