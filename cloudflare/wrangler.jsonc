{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharika-api-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sharika-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SHARIKA_ENV": "staging",
    "FIREBASE_PROJECT_ID": "",
    "ALLOWED_ORIGINS": ""
  }
}
