{
  "$schema": "../cloudflare/node_modules/wrangler/config-schema.json",
  "name": "sharika-games-web-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "account_id": "d81cf7c48fb9b36d468cb0a08720cd74",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
