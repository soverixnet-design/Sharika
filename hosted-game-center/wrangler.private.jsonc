{
  "$schema": "../cloudflare/node_modules/wrangler/config-schema.json",
  "name": "sharika-private-center-staging",
  "main": "src/private-index.mjs",
  "compatibility_date": "2026-11-19",
  "account_id": "d81cf7c48fb9b36d468cb0a08720cd74",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sharika-staging",
    "database_id": "b2c62252-12a5-4740-90c7-01a536d9a39a"
  }]
}